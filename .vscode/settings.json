{
  // "salesforcedx-vscode-core.push-or-deploy-on-save.enabled": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sfdx": true,
    "**/.sf": true
  },
  "files.exclude": {
    // "**/*.cls-meta.xml": true,
    // "**/*Test.cls": true,
