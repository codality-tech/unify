<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Shows the Reform Showcase tab and lets its components call Reform.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Reform Showcase</label>
    <classAccesses>
        <apexClass>ReformApi</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>Reform_Showcase</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
