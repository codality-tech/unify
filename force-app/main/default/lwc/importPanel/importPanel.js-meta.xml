<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Import Panel</masterLabel>
    <description>Imports a CSV file through an import format, and gives back the rows that failed.</description>
    <targets>
        <target>lightning__Tab</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="title" type="String" label="Title" default="Import" />
            <property
                name="format"
                type="String"
                label="Format"
                description="API name of the one import format this panel offers. Leave empty to let the person choose."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
