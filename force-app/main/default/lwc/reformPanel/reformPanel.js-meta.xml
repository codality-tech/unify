<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Reform Panel</masterLabel>
    <description>A table and form drawn from a Reform blueprint.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="blueprintName" type="String" label="Blueprint API name" required="true" />
            <property name="title" type="String" label="Title" />
            <property name="pageSize" type="Integer" label="Records per page" default="10" min="1" max="200" />
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="blueprintName" type="String" label="Blueprint API name" required="true" />
            <property
                name="parentField"
                type="String"
                label="Parent field"
                description="A lookup on the blueprint object that points at this record, such as AccountId. Lists only the children of this record and files new ones under it."
            />
            <property name="title" type="String" label="Title" />
            <property name="pageSize" type="Integer" label="Records per page" default="10" min="1" max="200" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
